# Wingrove Academy Sanity project (separate from ElevateED's g9vmcwkr)
NEXT_PUBLIC_SANITY_PROJECT_ID=lvh3kfks
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Public site URL (SEO metadata)
NEXT_PUBLIC_SITE_URL=https://wingroveacademy.ai

# Preview gate. SITE_PASSWORD replaces the starting password; SITE_GATE=off removes the gate at launch.
SITE_PASSWORD=
SITE_GATE=on

# Brand fonts (optional): Adobe Fonts web project ID for Kepler + Soleil, e.g. abc1def
NEXT_PUBLIC_ADOBE_FONTS_KIT=

# Wingrove's own HubSpot account (NOT ElevateED's). Become an Insider posts here once both are set.
HUBSPOT_PORTAL_ID=
HUBSPOT_INSIDER_FORM_ID=
HUBSPOT_REGION=

# Optional: also email each sign-up to the team through Resend
RESEND_API_KEY=
INSIDER_NOTIFY_TO=
INSIDER_FROM=
